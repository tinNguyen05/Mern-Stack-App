# Server Configuration
PORT=4000

# MongoDB Configuration
CONNECTION_STRING=mongodb://localhost:27017/food-recipe-app
# hoặc sử dụng MongoDB Atlas:
# CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/food-recipe-app?retryWrites=true&w=majority

# JWT Secret Key (thay đổi thành chuỗi ngẫu nhiên phức tạp)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Node Environment
NODE_ENV=development
