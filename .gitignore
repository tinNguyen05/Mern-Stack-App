# 1. Dependencies (Thư viện - Tuyệt đối không đẩy lên Git)
node_modules/
backend/node_modules/
frontend/node_modules/

# 2. Environment Variables (Thông tin bảo mật - Cực kỳ quan trọng)
.env
backend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 3. User Uploads (Các ảnh người dùng upload lên backend)
backend/public/images/*
# Giữ lại folder images nhưng bỏ qua nội dung bên trong
!backend/public/images/.gitkeep

# 4. Build Output (Sản phẩm sau khi đóng gói)
dist/
frontend/food-blog-app/dist/
frontend/food-blog-app/dist-ssr/
*.local

# 5. Debug logs (Nhật ký lỗi)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/npm-debug.log*
frontend/food-blog-app/npm-debug.log*

# 6. IDE/Editor (Cấu hình riêng của trình soạn thảo)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. OS Metadata (File rác của hệ điều hành)
.DS_Store
Thumbs.db